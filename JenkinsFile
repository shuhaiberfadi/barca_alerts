pipeline {
    agent any

    triggers {
        cron('0 10,17 * * *')
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Setup Python') {
            steps {
                echo 'Using system Python'
                bat 'C:\\Users\\user\\AppData\\Local\\Programs\\Python\\Python314\\python.exe --version'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'if exist requirements.txt pip install -r requirements.txt'
            }
        }

        stage('Run Script') {
            steps {
                bat 'C:\\Users\\user\\AppData\\Local\\Programs\\Python\\Python314\\python.exe barcelona_match_alert.py'
            }
        }
    }
}
